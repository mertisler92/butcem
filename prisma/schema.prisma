generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum CompanyStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  SUSPENDED
}

enum CompanyMemberRole {
  OWNER
  MANAGER
  MEMBER
}

enum DepositType {
  NONE
  FIXED
  PERCENTAGE
}

enum DeliveryOption {
  TENANT_PICKUP
  SUPPLIER_DELIVERS
  FREIGHT_REQUIRED
}

enum SetupOption {
  NONE
  OPTIONAL
  INCLUDED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  USED
}

enum BlockReason {
  MAINTENANCE
  RESERVED
  MANUAL_BLOCK
}

enum RFQStatus {
  DRAFT
  OPEN
  QUOTED
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  REQUESTED
  QUOTE_ACCEPTED
  PAYMENT_PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  ACTIVE
  RETURN_PENDING
  RETURNED
  INSPECTING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentProvider {
  SANDBOX
  BANK_TRANSFER
  CARI
}

enum DepositStatus {
  HELD
  RELEASED
  DEDUCTED_FOR_DAMAGE
}

enum ProtocolType {
  DELIVERY
  RETURN
}

enum DamageClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

enum ReviewRole {
  SUPPLIER_TO_TENANT
  TENANT_TO_SUPPLIER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  phone        String?
  role         Role            @default(USER)
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  memberships  CompanyMember[]
  sentMessages Message[]       @relation("SentMessages")
  auditLogs    AuditLog[]

  @@index([email])
}

model Company {
  id              String          @id @default(cuid())
  name            String
  taxNumber       String          @unique
  taxOffice       String
  address         String
  city            String
  website         String?
  companyType     String          // Anonim Şirket, Limited Şirket, Şahıs Şirketi
  status          CompanyStatus   @default(IN_REVIEW)
  logoUrl         String?
  phone           String?
  email           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         CompanyMember[]
  supplierProfile SupplierProfile?
  products        Product[]       @relation("SupplierProducts")
  rfqs            Rfq[]           @relation("TenantRFQs")
  quotes          Quote[]         @relation("SupplierQuotes")
  tenantOrders    Order[]         @relation("TenantOrders")
  supplierOrders  Order[]         @relation("SupplierOrders")
  givenReviews    Review[]        @relation("GivenReviews")
  receivedReviews Review[]        @relation("ReceivedReviews")
  favorites       Favorite[]
  auditLogs       AuditLog[]

  @@index([city])
  @@index([status])
}

model CompanyMember {
  id        String            @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model SupplierProfile {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  description         String?
  rating              Float    @default(5.0)
  reviewCount         Int      @default(0)
  completedRentals    Int      @default(0)
  responseTimeMinutes Int      @default(30)
  isVerified          Boolean  @default(false)
  serviceCities       String   @default("İstanbul,Ankara,İzmir") // Comma-separated or JSON
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Category {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  icon           String        // Lucide icon identifier
  description    String?
  commissionRate Float         @default(10.0) // Category-specific commission percentage
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subCategories  SubCategory[]
  products       Product[]
  rfqItems       RfqItem[]

  @@index([slug])
}

model SubCategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([categoryId])
  @@index([slug])
}

model Product {
  id                   String           @id @default(cuid())
  supplierCompanyId    String
  categoryId           String
  subCategoryId        String?
  name                 String
  slug                 String           @unique
  description          String
  brand                String?
  model                String?
  totalStock           Int              @default(1)
  minRentalDays        Int              @default(1)
  minQuantity          Int              @default(1)
  dailyPrice           Float
  weeklyPrice          Float?
  monthlyPrice         Float?
  purchasePriceEstimate Float?          // For comparison savings calculation
  depositType          DepositType      @default(NONE)
  depositAmount        Float            @default(0)
  depositPercent       Float            @default(0)
  vatRate              Float            @default(20.0)
  city                 String
  address              String?
  deliveryOption       DeliveryOption   @default(SUPPLIER_DELIVERS)
  deliveryFee          Float            @default(0)
  setupOption          SetupOption      @default(NONE)
  setupFee             Float            @default(0)
  condition            ProductCondition @default(GOOD)
  isActive             Boolean          @default(true)
  featured             Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  supplierCompany      Company          @relation("SupplierProducts", fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  category             Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory          SubCategory?     @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  images               ProductImage[]
  volumeDiscounts      VolumeDiscount[]
  availabilityBlocks   AvailabilityBlock[]
  quoteItems           QuoteItem[]
  orderItems           OrderItem[]
  favorites            Favorite[]

  @@index([supplierCompanyId])
  @@index([categoryId])
  @@index([city])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model VolumeDiscount {
  id              String   @id @default(cuid())
  productId       String
  minQuantity     Int
  maxQuantity     Int?
  discountPercent Float    // e.g. 5.0 for 5% off
  createdAt       DateTime @default(now())

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AvailabilityBlock {
  id        String      @id @default(cuid())
  productId String
  orderId   String?     // If associated with a confirmed order
  startDate DateTime
  endDate   DateTime
  quantity  Int
  reason    BlockReason @default(MAINTENANCE)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startDate, endDate])
  @@index([orderId])
}

model Rfq {
  id              String      @id @default(cuid())
  rfqNumber       String      @unique
  tenantCompanyId String
  title           String
  rawPrompt       String?     // If generated via AI NLP
  city            String
  address         String?
  startDate       DateTime
  endDate         DateTime
  deliveryNeeded  Boolean     @default(true)
  setupNeeded     Boolean     @default(false)
  status          RFQStatus   @default(OPEN)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenantCompany   Company     @relation("TenantRFQs", fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  items           RfqItem[]
  quotes          Quote[]
  orders          Order[]
  conversations   Conversation[]

  @@index([tenantCompanyId])
  @@index([city])
  @@index([status])
}

model RfqItem {
  id           String      @id @default(cuid())
  rfqId        String
  categoryId   String?
  productName  String
  quantity     Int
  targetBudget Float?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rfq          Rfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems   QuoteItem[]

  @@index([rfqId])
}

model Quote {
  id                String      @id @default(cuid())
  quoteNumber       String      @unique
  rfqId             String
  supplierCompanyId String
  status            QuoteStatus @default(PENDING)
  productTotal      Float
  deliveryFee       Float       @default(0)
  setupFee          Float       @default(0)
  depositTotal      Float       @default(0)
  vatTotal          Float       @default(0)
  discountTotal     Float       @default(0)
  grandTotal        Float
  validUntil        DateTime
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  rfq               Rfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierCompany   Company     @relation("SupplierQuotes", fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  items             QuoteItem[]
  orders            Order[]

  @@index([rfqId])
  @@index([supplierCompanyId])
  @@index([status])
}

model QuoteItem {
  id               String   @id @default(cuid())
  quoteId          String
  rfqItemId        String?
  productId        String?
  productName      String
  offeredQuantity  Int
  unitDailyPrice   Float
  totalDays        Int
  lineTotal        Float
  createdAt        DateTime @default(now())

  quote            Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem          RfqItem? @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}

model Order {
  id                     String            @id @default(cuid())
  orderNumber            String            @unique
  tenantCompanyId        String
  supplierCompanyId      String
  quoteId                String?
  rfqId                  String?
  startDate              DateTime
  endDate                DateTime
  status                 OrderStatus       @default(REQUESTED)
  deliveryOption         DeliveryOption    @default(SUPPLIER_DELIVERS)
  deliveryAddress        String
  deliveryCity           String
  deliveryFee            Float             @default(0)
  setupFee               Float             @default(0)
  productTotal           Float
  depositTotal           Float             @default(0)
  vatTotal               Float             @default(0)
  platformCommissionRate Float             @default(10.0)
  platformCommissionFee  Float             @default(0)
  supplierPayout         Float             @default(0)
  grandTotal             Float
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tenantCompany          Company           @relation("TenantOrders", fields: [tenantCompanyId], references: [id], onDelete: Restrict)
  supplierCompany        Company           @relation("SupplierOrders", fields: [supplierCompanyId], references: [id], onDelete: Restrict)
  quote                  Quote?            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  rfq                    Rfq?              @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  payments               Payment[]
  depositRecord          Deposit?
  protocols              HandoverProtocol[]
  damageClaims           DamageClaim[]
  conversations          Conversation[]
  reviews                Review[]

  @@index([tenantCompanyId])
  @@index([supplierCompanyId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitDailyPrice Float
  rentalDays     Int
  lineTotal      Float
  createdAt      DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  amount        Float
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(SANDBOX)
  transactionId String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Deposit {
  id              String        @id @default(cuid())
  orderId         String        @unique
  amount          Float
  status          DepositStatus @default(HELD)
  deductionAmount Float         @default(0)
  releasedAt      DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model HandoverProtocol {
  id                String       @id @default(cuid())
  orderId           String
  type              ProtocolType
  photosJson        String       @default("[]") // Array of image URLs
  deliveredQuantity Int
  notes             String?
  signedByName      String
  signedAt          DateTime     @default(now())
  createdAt         DateTime     @default(now())

  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DamageClaim {
  id                 String            @id @default(cuid())
  orderId            String
  description        String
  photosJson         String            @default("[]")
  claimedAmount      Float
  approvedAmount     Float?
  status             DamageClaimStatus @default(SUBMITTED)
  resolvedByAdminId  String?
  resolutionNotes    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Conversation {
  id          String    @id @default(cuid())
  orderId     String?
  rfqId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rfq         Rfq?      @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([orderId])
  @@index([rfqId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderUserId   String
  senderName     String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User         @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Review {
  id                  String     @id @default(cuid())
  orderId             String
  reviewerCompanyId   String
  revieweeCompanyId   String
  role                ReviewRole
  overallRating       Float      // 1-5
  subRatingsJson      String     // { quality, timing, communication, accuracy }
  comment             String?
  createdAt           DateTime   @default(now())

  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerCompany     Company    @relation("GivenReviews", fields: [reviewerCompanyId], references: [id], onDelete: Cascade)
  revieweeCompany     Company    @relation("ReceivedReviews", fields: [revieweeCompanyId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([reviewerCompanyId])
  @@index([revieweeCompanyId])
}

model Favorite {
  id               String   @id @default(cuid())
  companyId        String
  productId        String?
  targetSupplierId String?
  createdAt        DateTime @default(now())

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([productId])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  companyId   String?
  action      String   // e.g. "COMPANY_VERIFIED", "ORDER_CANCELLED", "PRICE_CHANGED"
  entity      String   // e.g. "Company", "Order"
  entityId    String
  detailsJson String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityId])
}
